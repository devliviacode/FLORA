<%- include('../includes/header', { titulo: 'Cadastrar Produto', usuario }) %>

<main class="container">
    <section class="card-sistema">
        <h1>CADASTRAR PRODUTO</h1>

        <form action="/produtos/novo" method="POST" enctype="multipart/form-data" class="form-cadastro">
            <div class="campo-bloco">
                <label for="nome_produto" class="campo-label">Nome do produto</label>
                <input type="text" id="nome_produto" name="nome_produto" maxlength="150" class="campo-flora" placeholder="Ex: Bolsa de Crochê Floral" required>
            </div>

            <div class="campo-bloco">
                <label for="descricao_produto" class="campo-label">Descrição</label>
                <textarea id="descricao_produto" name="descricao_produto" class="campo-flora" placeholder="Detalhes da peça, cor, fio, medidas..."></textarea>
            </div>

            <div class="linha-dupla">
                <div class="campo-bloco">
                    <label for="id_categoria" class="campo-label">Categoria</label>
                    <select id="id_categoria" name="id_categoria" class="campo-flora" required>
                        <option value="" disabled selected>Selecione uma categoria</option>
                        <% if (categorias && categorias.length > 0) { %>
                            <% categorias.forEach(cat => { %>
                                <option value="<%= cat.id_categoria %>"><%= cat.nome_categoria %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="campo-bloco">
                    <label for="valor_produto" class="campo-label">Valor (R$)</label>
                    <input type="number" id="valor_produto" name="valor_produto" step="0.01" min="0" class="campo-flora" placeholder="Ex: 149.90" required>
                </div>
            </div>

            <div class="linha-dupla">
                <div class="campo-bloco">
                    <label for="quantidade_produto" class="campo-label">Quantidade em estoque</label>
                    <input type="number" id="quantidade_produto" name="quantidade_produto" min="0" class="campo-flora" placeholder="Ex: 10" required>
                </div>

                <div class="campo-bloco">
                    <label for="estoque_minimo" class="campo-label">Estoque mínimo</label>
                    <input type="number" id="estoque_minimo" name="estoque_minimo" min="0" class="campo-flora" placeholder="Ex: 3" required>
                </div>
            </div>

            <div class="linha-dupla">
                <div class="campo-bloco">
                    <label class="campo-label">Imagem do produto</label>
                    <label for="imagem_produto" class="upload-flora">
                        <span id="nome-arquivo">Selecionar imagem (.jpg, .png)</span>
                        <input type="file" id="imagem_produto" name="imagem_produto" accept="image/*">
                    </label>
                </div>

                <div class="campo-bloco">
                    <label for="situacao_produto" class="campo-label">Situação</label>
                    <select id="situacao_produto" name="situacao_produto" class="campo-flora">
                        <option value="Ativo" selected>Ativo</option>
                        <option value="Inativo">Inativo</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn-entrar">Cadastrar Produto</button>
            <a href="/dashboard" class="btn-cancelar-link">Cancelar e voltar ao Dashboard</a>
        </form>
    </section>
</main>

<script>
    const inputImagem = document.getElementById('imagem_produto');
    const textoArquivo = document.getElementById('nome-arquivo');

    inputImagem.addEventListener('change', function () {
        textoArquivo.textContent = (this.files && this.files.length > 0)
            ? this.files[0].name
            : 'Selecionar imagem (.jpg, .png)';
    });
</script>

<%- include('../includes/footer') %>